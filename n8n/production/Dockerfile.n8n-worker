# Multi-stage build for n8n queue workers that run the repo pipelines.
# The n8n base image ships Node, so we only add the shell tools the
# Execute Command nodes rely on: bash, git (clone/inventory), docker CLI
# (to run the analyzer images) and python3 (optional graph entry points).
FROM n8nio/n8n:latest

USER root

RUN apk add --no-cache bash git curl jq python3 py3-pip openssh-client \
    && if ! command -v docker >/dev/null 2>&1; then \
         apk add --no-cache docker-cli docker-cli-compose; \
       fi \
    && ln -sf /usr/bin/python3 /usr/local/bin/python

# The compose file mounts the host's /var/run/docker.sock, so the worker can
# dispatch `docker run` for the analyzer images. n8n's unprivileged user needs
# to be a member of the docker group to use the socket. Compose sets DOCKER_GID.
ARG DOCKER_GID=999
RUN if getent group docker >/dev/null 2>&1; then \
      groupmod -g "${DOCKER_GID}" docker 2>/dev/null || true; \
    else \
      addgroup -g "${DOCKER_GID}" docker; \
    fi \
    && addgroup node docker

USER node
