# Copy to .env and edit. Values here become n8n instance env vars, which the
# workflows read via {{ $env.* }}.

# Absolute path to the multi-tool checkout on THIS host. The pipeline scripts
# (transit-repo/, internal-repo/) and the run volume live under it.
MULTITOOL_ROOT=/opt/multi-tool

# Shared filesystem "queue" used by dispatcher -> workers -> aggregator/retry.
# Must be the same absolute path in every container. Use NFS/EFS for multi-host.
RUN_ROOT=/opt/multi-tool/n8n/runs

# Repos per job chunk. Bigger = fewer claims; smaller = better load spread.
CHUNK_SIZE=50

# Reclaim a chunk stuck in .processing after this many minutes (killed worker).
STALE_MIN=15

# Retry window: only failures in the last N hours are re-enqueued. Max per pass.
RETRY_WINDOW_HOURS=24
RETRY_MAX=200

# Aggregator: purge run artifacts older than N days.
PURGE_AFTER_DAYS=14

# n8n database / app
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
GENERIC_TIMEZONE=UTC
N8N_PORT=5678

# Queue mode worker replicas (compose.scale.yml)
WORKER_REPLICAS=3
